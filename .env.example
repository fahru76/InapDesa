# ─── Site ────────────────────────────────────────────────────────────────
# Public base URL (used for Stripe return URLs, QR check-in links, magic links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. SERVER ONLY.
SUPABASE_SECRET_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys (use test keys while developing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# From `stripe listen` (local) or Dashboard → Webhooks → signing secret (production)
STRIPE_WEBHOOK_SECRET=whsec_

# ─── Booking engine ──────────────────────────────────────────────────────
# Minutes an unpaid checkout holds the dates before they are released
BOOKING_HOLD_MINUTES=15

# ─── Host access ─────────────────────────────────────────────────────────
# Comma-separated emails allowed to sign in to /host (recommended in production).
# Leave empty to allow any account that can sign in.
HOST_EMAIL_ALLOWLIST=

# ─── Billplz (Malaysian e-wallets, DuitNow QR, FPX) — optional ───────────
# Leave empty until your Billplz account is ready; the e-wallet option stays hidden.
# Billplz → Settings → Keys & Integration
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
# "true" = billplz-sandbox.com (default), "false" = live billplz.com
BILLPLZ_SANDBOX=true

# ─── Guest emails (confirmation, arrival reminders, review invite) — optional ─
# Resend (resend.com) → API Keys. Leave empty to turn emails off.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend, e.g. "Teratak Senja <stay@yourdomain.my>"
EMAIL_FROM=

# ─── Scheduled jobs (calendar sync + reminders) — optional ─────────────────
# Any long random string (16+ characters). Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
